{
  "name": "castle-cli",
  "version": "2.0.2",
  "description": "Castle CLI for local deck creation, preview, editing, and saving",
  "license": "ISC",
  "type": "module",
  "main": "dist/index.js",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/castle-xyz/castle-cli.git"
  },
  "bin": {
    "castle": "dist/index.js"
  },
  "files": [
    "dist/",
    "ide/dist/",
    "bundles/player/",
    "data/agent/",
    "docs/agent/",
    "docs/simple/",
    "docs/full/",
    "CLAUDE.md",
    "README.md"
  ],
  "scripts": {
    "prepack": "npm run build",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true }); require('fs').rmSync('ide/dist', { recursive: true, force: true })\"",
    "build": "npm run clean && npm run build:ide && tsc",
    "build:ide": "vite build --config ide/vite.config.ts",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts"
  },
  "dependencies": {
    "@lydell/node-pty": "^1.2.0-beta.12",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/headless": "^6.0.0",
    "axios": "^1.13.5",
    "chokidar": "^4.0.3",
    "open": "^11.0.0",
    "ws": "^8.18.0",
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^6.0.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.10"
  }
}
