{
  "name": "castle-cli",
  "version": "2.0.2",
  "description": "Castle CLI for local deck creation, preview, editing, and saving",
  "license": "ISC",
  "type": "module",
  "main": "dist/index.js",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/castle-xyz/castle-cli.git"
  },
  "bin": {
    "castle": "dist/index.js"
  },
  "files": [
    "dist/",
    "bundles/player/",
    "data/agent/",
    "docs/agent/",
    "docs/simple/",
    "docs/full/",
    "CLAUDE.md",
    "README.md"
  ],
  "scripts": {
    "prepack": "npm run build",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts"
  },
  "dependencies": {
    "axios": "^1.13.5",
    "chokidar": "^4.0.3",
    "open": "^11.0.0",
    "ws": "^8.18.0",
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
